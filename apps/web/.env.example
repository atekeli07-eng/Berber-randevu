# Bu dosyayı Vercel → Settings → Environment Variables ekranına tek tek girin.
# apps/web/.env.local yalnızca kendi bilgisayarınız içindir. Git’e koyulmaz.
# service_role anahtarını hiçbir yere yazmayın.

# Zorunlu. Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Zorunlu. Aynı ekrandaki anon public anahtarı. service_role değil.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Zorunlu. Sitenin kalıcı adresi, sonda / olmadan. Örnek: https://berberimrandevu.com
# Randevu bağlantısı ve şifre sıfırlama bu adresi kullanır.
NEXT_PUBLIC_SITE_URL=https://siteniz.com

# Zorunlu, yayından önce. KVKK ve gizlilik sayfalarındaki şirket unvanı.
NEXT_PUBLIC_COMPANY_NAME=Örnek Berber Yazılım Ltd. Şti.

# Zorunlu, yayından önce. Veri sorumlusunun açık adresi.
NEXT_PUBLIC_COMPANY_ADDRESS=Örnek Mah. Örnek Sk. No: 1 Beyoğlu/İstanbul

# Zorunlu, yayından önce. Müşteri ve mağaza destek e-postası.
NEXT_PUBLIC_CONTACT_EMAIL=destek@siteniz.com

# Zorunlu, yayından önce. KVKK başvurularının gideceği adres.
# Boş bırakılırsa destek e-postası kullanılır. Ayrı bir kvkk adresi varsa onu yazın.
NEXT_PUBLIC_KVKK_EMAIL=kvkk@siteniz.com

# İsteğe bağlı. Cloudflare Turnstile. Üçü birden boşsa randevu doğrulaması kapalıdır.
# Üretimde üçünü birlikte doldurun. Bilet sırrının aynısını veritabanına da yazın:
# insert into private.settings (key, value) values ('booking_ticket_secret', 'AYNI_SIR')
# on conflict (key) do update set value = excluded.value;
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOOKING_TICKET_SECRET=
