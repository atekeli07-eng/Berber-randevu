# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Randevu bağlantısı kopyalanırken kullanılır. Boşsa tarayıcı adresi kullanılır.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile. Üçü birden boşsa doğrulama kapalıdır.
# Üretimde üçünü birlikte doldurun ve bilet sırrını veritabanına da yazın:
# insert into private.settings (key, value) values ('booking_ticket_secret', 'AYNI_SIR')
# on conflict (key) do update set value = excluded.value;
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOOKING_TICKET_SECRET=
