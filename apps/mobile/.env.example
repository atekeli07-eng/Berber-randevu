# Bu değerler telefon derlemesine gömülür. EAS production ortamına da aynılarını yazın.
# GitHub Actions, bu üçü secret olarak duruyorsa EAS’e kendisi yollar.
# service_role anahtarını yazmayın.

# Zorunlu. Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Zorunlu. Aynı ekrandaki anon public anahtarı.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Zorunlu. Web sitesinin adresi, sonda / olmadan. Ayarlar ekranı randevu bağlantısını bununla paylaşır.
EXPO_PUBLIC_SITE_URL=https://siteniz.com

# eas init sonrası Expo’nun verdiği proje kimliği. app.config.ts bunu okur.
# GitHub secret adı da EAS_PROJECT_ID olsun.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Expo hesabının kullanıcı adı. İsteğe bağlı.
# EXPO_ACCOUNT_OWNER=kullanici-adiniz
