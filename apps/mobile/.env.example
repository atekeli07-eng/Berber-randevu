# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web sitesinin adresi. Doluysa Ayarlar ekranı randevu bağlantısını paylaşır.
EXPO_PUBLIC_SITE_URL=http://localhost:3000

# eas init sonrası Expo’nun verdiği proje kimliği. app.config.ts bunu okur.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Expo hesabının kullanıcı adı. İsteğe bağlı.
# EXPO_ACCOUNT_OWNER=kullanici-adiniz
